integrations:
  shadcn:
    enabled: false
  framework:
    name: Timeless/DMUI
    component_styles: frontend/src/dmui.css
    page_styles: frontend/src/style.css

locked: []

omitted:
  - assets: "No repo-level brand asset contract was requested or inferred."
  - figma: "No Figma source is connected."
  - sound-files: "Product sound is disabled."
