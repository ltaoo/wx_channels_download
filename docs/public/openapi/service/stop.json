{
  "post": {
    "tags": [
      "服务"
    ],
    "summary": "停止指定服务",
    "description": "name 可通过 JSON 或 query 传入；禁止通过本接口停止 api 服务。发布停止命令后立即返回当前服务状态。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "post_api_service_stop",
    "parameters": [
      {
        "name": "name",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "服务名称；JSON 请求体的 name 优先，proxy 等同 interceptor"
      }
    ],
    "requestBody": {
      "required": false,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../components.json#/schemas/api_service_action_body"
          },
          "example": {
            "name": "interceptor"
          }
        }
      }
    }
  }
}
