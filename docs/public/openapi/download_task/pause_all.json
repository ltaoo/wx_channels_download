{
  "post": {
    "tags": [
      "下载任务"
    ],
    "summary": "暂停全部运行中任务",
    "description": "暂停符合状态的未删除任务。普通任务进入已暂停状态；包含 STREAM 资源的直播任务会停止并收尾为已完成。请求体可省略。",
    "requestBody": {
      "required": false,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "preparing",
                  "downloading",
                  "running"
                ],
                "description": "按准备中、下载中或两者筛选；省略或传入其他值时等同 running"
              }
            }
          },
          "example": {
            "status": "running"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "统一业务响应；所有业务响应的 HTTP 状态码均为 200",
        "content": {
          "application/json": {
            "examples": {
              "success": {
                "summary": "没有运行中的任务",
                "value": {
                  "code": 0,
                  "msg": "成功",
                  "data": {
                    "failures": null,
                    "paused": 0,
                    "total": 0
                  }
                }
              },
              "database_unavailable": {
                "summary": "数据库不可用",
                "value": {
                  "code": 500,
                  "msg": "应用未初始化，数据库不可用"
                }
              }
            }
          }
        }
      }
    }
  }
}
