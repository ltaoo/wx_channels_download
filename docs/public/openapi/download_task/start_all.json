{
  "post": {
    "tags": [
      "下载任务"
    ],
    "summary": "启动全部可启动任务",
    "description": "查询符合状态的未删除任务，并将其全部提交到下载队列。下载器按最大并发数依次执行，当前批次完成后会继续执行后续任务；提交失败的任务会被跳过。started 是成功提交数，total 是符合筛选条件的任务总数。请求体可省略。",
    "requestBody": {
      "required": false,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "waiting",
                  "paused",
                  "failed"
                ],
                "description": "按状态启动；省略或传入其他值时启动全部等待中、已暂停和失败任务"
              }
            }
          },
          "example": {
            "status": "waiting"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "统一业务响应；所有业务响应的 HTTP 状态码均为 200",
        "content": {
          "application/json": {
            "examples": {
              "success": {
                "summary": "没有等待中的任务",
                "value": {
                  "code": 0,
                  "msg": "成功",
                  "data": {
                    "started": 0,
                    "total": 0
                  }
                }
              },
              "database_unavailable": {
                "summary": "数据库不可用",
                "value": {
                  "code": 500,
                  "msg": "应用未初始化，数据库不可用"
                }
              }
            }
          }
        }
      }
    }
  }
}
