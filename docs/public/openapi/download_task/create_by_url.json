{
  "post": {
    "tags": [
      "下载任务"
    ],
    "summary": "批量创建 URL 下载任务",
    "description": "直接从绝对资源 URL 创建任务、资源和下载端点。默认自动启动；单项失败记录在 tasks 中，不影响同批其他对象。所有业务响应的 HTTP 状态码均为 200。",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "objects"
            ],
            "properties": {
              "objects": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "包含 scheme 和 host 的资源 URL"
                    },
                    "download_dir": {
                      "type": "string",
                      "description": "下载目录；为空时依次读取 config.download_dir 和应用默认目录"
                    },
                    "filename": {
                      "type": "string",
                      "description": "文件名；为空时依次读取 config.filename 和 URL 路径末段"
                    },
                    "config": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "auto_start": {
                      "type": "boolean",
                      "default": true
                    },
                    "parent_task_id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "relation_type": {
                      "type": "string",
                      "enum": [
                        "discovered",
                        "derived",
                        "dependency"
                      ]
                    }
                  }
                }
              }
            }
          },
          "example": {
            "objects": [
              {
                "url": "https://example.com/files/example.json",
                "download_dir": "/data/downloads",
                "filename": "example.json",
                "config": {},
                "auto_start": false
              }
            ]
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "批量创建结果，tasks 与输入对象逐项对应",
        "content": {
          "application/json": {
            "examples": {
              "success": {
                "summary": "auto_start=false 创建成功",
                "value": {
                  "code": 0,
                  "msg": "成功",
                  "data": {
                    "tasks": [
                      {
                        "data": {
                          "endpoint": {
                            "id": 160,
                            "resource_id": 160,
                            "protocol": "HTTPS",
                            "url": "https://example.com/files/example.json",
                            "priority": 0,
                            "enabled": 1,
                            "headers": "",
                            "cookies": "",
                            "status": 0,
                            "created_at": 1787019341973,
                            "updated_at": 1787019341973,
                            "deleted_at": null
                          },
                          "resource": {
                            "id": 160,
                            "task_id": 44,
                            "download_dir": "/data/downloads",
                            "name": "example.json",
                            "kind": "file",
                            "unique_id": "",
                            "type": "file",
                            "size": 0,
                            "downloaded": 0,
                            "speed": 0,
                            "status": 0,
                            "merge_order": 0,
                            "extra": "",
                            "stream_url": "",
                            "record_start": null,
                            "record_end": null,
                            "duration": 0,
                            "rotate_minutes": 0,
                            "rotate_size": 0,
                            "start_time": null,
                            "finish_time": null,
                            "created_at": 1787019341973,
                            "updated_at": 1787019341973,
                            "deleted_at": null
                          },
                          "task": {
                            "id": 44,
                            "root_task_id": 44,
                            "name": "example.json",
                            "platform_id": "",
                            "unique_id": "",
                            "status": 0,
                            "source_url": "",
                            "cover_url": "",
                            "cover_width": "",
                            "cover_height": "",
                            "config_json": "{\"download_dir\":\"/data/downloads\",\"filename\":\"example.json\",\"url\":\"https://example.com/files/example.json\"}",
                            "metadata_json": "",
                            "error_message": "",
                            "created_at": 1787019341973,
                            "updated_at": 1787019341,
                            "deleted_at": null
                          }
                        },
                        "success": true
                      }
                    ]
                  }
                }
              },
              "item_failed": {
                "summary": "单项创建失败",
                "value": {
                  "code": 0,
                  "msg": "成功",
                  "data": {
                    "tasks": [
                      {
                        "success": false,
                        "error": "无效的下载地址"
                      }
                    ]
                  }
                }
              },
              "invalid_body": {
                "summary": "未传入对象",
                "value": {
                  "code": 400,
                  "msg": "请求体不能为空数组"
                }
              }
            }
          }
        }
      }
    }
  }
}
