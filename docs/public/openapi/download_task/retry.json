{
  "post": {
    "tags": [
      "下载任务"
    ],
    "summary": "批量重试下载任务",
    "description": "仅重试失败（6）或已取消（7）的任务。重试前清空错误信息并将任务交给下载器重新启动。每个任务独立返回结果。",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "task_ids"
            ],
            "properties": {
              "task_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer"
                }
              }
            }
          },
          "example": {
            "task_ids": [
              42
            ]
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "统一业务响应；所有业务响应的 HTTP 状态码均为 200",
        "content": {
          "application/json": {
            "examples": {
              "success": {
                "summary": "重试成功",
                "value": {
                  "code": 0,
                  "msg": "成功",
                  "data": {
                    "results": [
                      {
                        "status_text": "preparing",
                        "success": true,
                        "task": {
                          "id": 44,
                          "root_task_id": 44,
                          "name": "example.json",
                          "platform_id": "",
                          "unique_id": "",
                          "status": 1,
                          "source_url": "",
                          "cover_url": "",
                          "cover_width": "",
                          "cover_height": "",
                          "config_json": "{\"download_dir\":\"/data/downloads\",\"filename\":\"example.json\",\"url\":\"https://example.com/files/example.json\"}",
                          "metadata_json": "",
                          "error_message": "",
                          "created_at": 1787019341973,
                          "updated_at": 1787019377403,
                          "deleted_at": null
                        },
                        "task_id": 44
                      }
                    ]
                  }
                }
              },
              "wrong_status": {
                "summary": "当前状态不可重试",
                "value": {
                  "code": 0,
                  "msg": "成功",
                  "data": {
                    "results": [
                      {
                        "task_id": 42,
                        "success": false,
                        "error": "当前状态不允许重试"
                      }
                    ]
                  }
                }
              },
              "invalid_body": {
                "summary": "task_ids 为空",
                "value": {
                  "code": 400,
                  "msg": "task_ids 不能为空"
                }
              }
            }
          }
        }
      }
    }
  }
}
