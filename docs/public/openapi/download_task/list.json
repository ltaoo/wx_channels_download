{
  "get": {
    "tags": [
      "下载任务"
    ],
    "summary": "查询下载任务",
    "description": "不传 task_id 时返回分页列表；传入正整数 task_id 时直接返回单个完整任务记录，并忽略分页参数。当前实现按 task_id 查询时也可能返回已软删除的任务本体，但其 files 通常为空。status 支持逗号分隔的多个数字状态。所有业务响应的 HTTP 状态码均为 200。任务状态：0=等待中，1=准备中，2=下载中，3=已暂停，4=合并中，5=已完成，6=失败，7=已取消。",
    "parameters": [
      {
        "name": "task_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "按 download_task 主键查询单个任务"
      },
      {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "description": "分页页码"
      },
      {
        "name": "page_size",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "description": "每页条数；超出 1-100 时回退为 20"
      },
      {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "example": "0,3,6"
        },
        "description": "任务状态数字，多个值用逗号分隔"
      },
      {
        "name": "parent_task_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "只返回指定父任务的直接子任务"
      },
      {
        "name": "root_task_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "只返回指定根任务所属的任务树"
      }
    ],
    "responses": {
      "200": {
        "description": "单个任务或分页任务列表",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "code",
                "msg"
              ],
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "oneOf": [
                    {
                      "type": "object",
                      "description": "传 task_id 时为单个下载任务记录"
                    },
                    {
                      "type": "object",
                      "required": [
                        "list",
                        "total",
                        "page",
                        "page_size",
                        "stats"
                      ],
                      "properties": {
                        "list": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "total": {
                          "type": "integer"
                        },
                        "page": {
                          "type": "integer"
                        },
                        "page_size": {
                          "type": "integer"
                        },
                        "stats": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "integer"
                          },
                          "description": "按数字状态分组的数量；沿用 parent_task_id/root_task_id，但不受 status 参数限制"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "examples": {
              "page": {
                "summary": "分页列表中的等待态 URL 任务",
