{
  "post": {
    "tags": [
      "标签"
    ],
    "summary": "设置内容的完整标签集合",
    "description": "设置内容的完整标签集合。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "content_id": {
                      "type": "string"
                    },
                    "tag_ids": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "post_api_tag_content_set",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "content_id": {
                "type": "string",
                "minLength": 1
              },
              "tag_ids": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            },
            "required": [
              "content_id",
              "tag_ids"
            ]
          },
          "example": {
            "content_id": "bilibili:BV1xx411c7mD",
            "tag_ids": [
              1,
              2
            ]
          }
        }
      }
    }
  }
}
