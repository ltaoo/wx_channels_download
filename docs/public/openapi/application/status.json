{
  "get": {
    "tags": [
      "应用"
    ],
    "summary": "查询应用与服务状态",
    "description": "查询应用与服务状态。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "server_statuses": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "api": {
                      "type": "object",
                      "properties": {
                        "addr": {
                          "type": "string"
                        },
                        "listening": {
                          "type": "boolean"
                        },
                        "status": {
                          "type": "string"
                        }
                      }
                    },
                    "proxy": {
                      "type": "object",
                      "properties": {
                        "addr": {
                          "type": "string"
                        },
                        "listening": {
                          "type": "boolean"
                        },
                        "status": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "get_api_status"
  }
}
