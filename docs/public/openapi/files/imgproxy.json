{
  "get": {
    "tags": [
      "文件"
    ],
    "summary": "代理读取远程图片",
    "description": "代理读取远程图片。",
    "responses": {
      "200": {
        "description": "上游图片原始字节及 Content-Type",
        "content": {
          "image/*": {
            "schema": {
              "type": "string",
              "format": "binary"
            }
          }
        }
      },
      "400": {
        "description": "缺少 url，code=-1",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      },
      "502": {
        "description": "上游请求失败，code=-1",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "get_imgproxy",
    "parameters": [
      {
        "name": "url",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "目标 URL"
      }
    ]
  }
}
