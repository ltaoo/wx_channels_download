{
  "get": {
    "tags": [
      "公众号"
    ],
    "summary": "订阅微信页面公众号消息",
    "description": "默认 RSS 2.0；format 可选 rss/rss2、atom、json/jsonfeed。username 为公众号微信用户名，需要在线公众号页面连接。",
    "responses": {
      "200": {
        "description": "HTTP 200；code=0 成功，非零为业务失败，以 msg 判断错误。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "application/rss+xml": {
            "schema": {
              "type": "string"
            }
          },
          "application/atom+xml": {
            "schema": {
              "type": "string"
            }
          },
          "application/feed+json": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "parameters": [
      {
        "name": "format",
        "in": "path",
        "required": true,
        "description": "format",
        "schema": {
          "type": "string",
          "enum": [
            "rss",
            "rss2",
            "atom",
            "json",
            "jsonfeed"
          ]
        }
      },
      {
        "name": "username",
        "in": "query",
        "required": true,
        "description": "username",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "offset",
        "in": "query",
        "required": false,
        "description": "offset",
        "schema": {
          "type": "string"
        }
      }
    ]
  }
}
