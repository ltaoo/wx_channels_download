{
  "post": {
    "tags": [
      "代理与证书"
    ],
    "summary": "替换、安装根证书并重启代理",
    "description": "卸载已安装的旧证书，生成有效期 10 年的新证书，保存配置，安装新证书并请求重启代理。系统证书操作可能需要系统权限。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "$ref": "../components.json#/schemas/ProxyStatus"
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "post_api_proxy_certificate_replace"
  }
}
