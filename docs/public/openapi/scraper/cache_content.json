{
  "get": {
    "tags": [
      "抓取"
    ],
    "summary": "预览抓取缓存内容",
    "description": "只预览指定任务的缓存条目，文件必须为普通文件且不超过 8 MiB；content 是按 UTF-8 修复后的文本，不是二进制下载。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "content_type": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "get_api_scraper_cache_content",
    "parameters": [
      {
        "name": "id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "对象主键；具体对象类型见接口说明"
      },
      {
        "name": "key",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "抓取缓存条目 key"
      }
    ]
  }
}
