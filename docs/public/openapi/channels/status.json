{
  "get": {
    "tags": [
      "视频号"
    ],
    "summary": "查询视频号页面连接状态",
    "description": "查询当前是否至少有一个视频号页面通过 /ws/channels 连接到下载器。available 为 true 表示服务端可以向 channels.ws.js 发送前端 API 请求；具体微信 API 调用仍可能因页面状态或登录状态失败。",
    "responses": {
      "200": {
        "description": "成功响应",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer",
                  "example": 0
                },
                "msg": {
                  "type": "string",
                  "example": "成功"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "available": {
                      "type": "boolean",
                      "description": "是否存在可接收前端 API 请求的视频号页面连接",
                      "example": true
                    }
                  },
                  "required": [
                    "available"
                  ]
                }
              },
              "required": [
                "code",
                "msg",
                "data"
              ]
            }
          }
        }
      }
    }
  }
}
