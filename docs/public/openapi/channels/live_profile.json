{
  "get": {
    "tags": [
      "视频号"
    ],
    "summary": "获取视频号直播详情",
    "description": "通过视频号页面的 joinLive API 获取直播详情。调用时需要保持视频号页面打开。所有 ID 均以字符串传入，避免大整数精度损失。",
    "parameters": [
      {
        "name": "oid",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "直播 objectId"
      },
      {
        "name": "nid",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "直播 objectNonceId"
      },
      {
        "name": "id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "直播 liveId"
      }
    ],
    "responses": {
      "200": {
        "description": "成功响应",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer",
                  "example": 0
                },
                "msg": {
                  "type": "string",
                  "example": "成功"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "errCode": {
                      "type": "integer",
                      "example": 0
                    },
                    "errMsg": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "baseResponse": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "liveCookies": {
