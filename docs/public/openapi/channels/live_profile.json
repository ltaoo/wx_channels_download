                            },
                            "endTime": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "participantCount": {
                              "type": "integer"
                            }
                          },
                          "additionalProperties": true
                        },
                        "liveDescription": {
                          "type": "string"
                        },
                        "serverTime": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": true
                    },
                    "payload": {
                      "type": "object",
