                          "description": "直播会话凭据"
                        },
                        "liveSdkInfo": {
                          "type": "object",
                          "properties": {
                            "sdkAppid": {
                              "type": "integer"
                            },
                            "sdkUserId": {
                              "type": "string"
                            },
                            "sdkLiveId": {
                              "type": "integer"
                            },
                            "sdkRoleId": {
                              "type": "integer"
                            },
                            "liveId": {
                              "type": "string"
                            },
                            "liveCdnUrl": {
                              "type": "string",
                              "format": "uri"
                            }
