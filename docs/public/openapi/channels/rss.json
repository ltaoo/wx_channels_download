{
  "get": {
    "tags": [
      "视频号"
    ],
    "summary": "RSS 订阅",
    "description": "调用视频号列表抓取后返回 Atom 订阅元信息；当前实现尚未将视频列表写入 entry，因此成功响应为不含视频条目的 Feed。失败返回 code/msg JSON。",
    "parameters": [
      {
        "name": "username",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "视频号 ID"
      },
      {
        "name": "next_marker",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "分页标记"
      }
    ],
    "responses": {
      "200": {
        "description": "RSS XML",
        "content": {
          "application/atom+xml": {
            "schema": {
              "type": "string"
            }
          },
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
