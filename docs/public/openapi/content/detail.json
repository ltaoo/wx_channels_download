                            "type": "integer",
                            "format": "int64",
                            "nullable": true
                          },
                          "finish_time": {
                            "type": "integer",
                            "format": "int64",
                            "nullable": true
                          },
                          "created_at": {
                            "type": "integer",
                            "format": "int64"
                          },
                          "updated_at": {
                            "type": "integer",
                            "format": "int64"
                          },
                          "local_path": {
                            "type": "string"
