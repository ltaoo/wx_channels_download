                          "type": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "size": {
                            "type": "integer",
                            "format": "int64"
                          },
                          "downloaded": {
                            "type": "integer",
                            "format": "int64"
