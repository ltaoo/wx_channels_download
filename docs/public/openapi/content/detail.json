                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "platform_id": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "external_id": {
                      "type": "string"
                    },
                    "external_id2": {
                      "type": "string"
                    },
                    "external_id3": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "source_url": {
                      "type": "string"
                    },
                    "cover_url": {
                      "type": "string"
                    },
                    "cover_width": {
                      "type": "string"
                    },
                    "cover_height": {
                      "type": "string"
                    },
