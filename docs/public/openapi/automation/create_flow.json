{
  "post": {
    "tags": [
      "自动化"
    ],
    "summary": "创建自定义工作流",
    "description": "仅创建包含 StartNode 的共享流程，不创建默认实例。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "$ref": "../components.json#/schemas/model_UserFlow"
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "post_api_v1_automation_create_flow",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "context_schema": {
                "type": "array",
                "items": {
                  "$ref": "../components.json#/schemas/engine_FieldSchema"
                }
              }
            },
            "required": [
              "name"
            ]
          },
          "example": {
            "name": "示例工作流",
            "trigger_type": "Manual"
          }
        }
      }
    }
  }
}
