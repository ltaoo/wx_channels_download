{
  "post": {
    "tags": [
      "自动化"
    ],
    "summary": "获取工作流可视化图",
    "description": "flow_id 省略或为空时返回全部自定义工作流图；指定时仅返回该工作流。请求体可省略。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "$ref": "../components.json#/schemas/flowengine_FlowVisualizationPayload"
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "post_api_v1_automation_get_flow_graph",
    "requestBody": {
      "required": false,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "flow_id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
