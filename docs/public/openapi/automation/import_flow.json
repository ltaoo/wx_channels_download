{
  "post": {
    "tags": [
      "自动化"
    ],
    "summary": "从定义 JSON 字符串导入工作流",
    "description": "导入共享流程图和可选 default_node_configs，只创建流程，不创建实例或触发规则。非空 triggers 会被拒绝，触发规则应在实例中配置。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "$ref": "../components.json#/schemas/model_UserFlow"
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "post_api_v1_automation_import_flow",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "definition": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "definition"
            ]
          }
        }
      }
    }
  }
}
