{
  "post": {
    "tags": [
      "自动化"
    ],
    "summary": "创建自动化计划",
    "description": "name、instance_id 必填；schedule 与 cron_expr 至少提供一个。schedule 支持按间隔、多个时间点、分时段、Cron、仅手动，优先于 cron_expr；未提供时兼容原 Cron（五段及 @daily、@every）。新策略时区默认 Asia/Shanghai，间隔单位秒。timeout_sec 非正数时默认 3600，上限 86400。返回的 initial_data.__automation.schedule 保存定时策略。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "$ref": "../components.json#/schemas/model_FlowSchedule"
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "post_api_v1_automation_create_schedule",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "cron_expr": {
                "type": "string",
                "minLength": 1
              },
              "flow_id": {
                "type": "string",
                "minLength": 1
              },
              "initial_data": {
                "type": "object",
                "additionalProperties": true
              },
              "enabled": {
                "type": "boolean",
                "nullable": true
              },
              "timeout_sec": {
                "type": "integer",
                "default": 3600,
                "maximum": 86400
              },
              "instance_id": {
                "type": "string",
                "description": "流程实例 ID；执行历史按实例过滤。"
              },
              "schedule": {
                "$ref": "../components.json#/schemas/flowengine_SchedulePolicy"
              }
            },
            "required": [
              "name",
              "instance_id"
            ],
            "anyOf": [
              {
                "required": [
                  "cron_expr"
                ]
              },
              {
                "required": [
                  "schedule"
                ]
              }
            ]
          },
          "example": {
            "name": "工作日早晚执行",
            "instance_id": "instance-demo",
            "schedule": {
              "mode": "times",
              "days": [
                1,
                2,
                3,
                4,
                5
              ],
              "times": [
                "08:00",
                "18:00"
              ],
              "timezone": "Asia/Shanghai"
            }
          }
        }
      }
    }
  }
}
