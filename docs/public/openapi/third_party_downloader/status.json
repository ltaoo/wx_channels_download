{
  "post": {
    "tags": [
      "三方下载器"
    ],
    "summary": "查询三方下载器进度",
    "description": "task_id 为三方下载器任务 ID 字符串。percent 为 0–100，completed/total 为字节数，speed 为字节/秒。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "$ref": "../components.json#/schemas/api_third_party_downloader_status_result"
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "post_api_v1_third_party_downloader_status",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "endpoint": {
                "type": "string"
              },
              "token": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "directory": {
                "type": "string"
              },
              "referer": {
                "type": "string"
              },
              "cookie": {
                "type": "string"
              },
              "user_agent": {
                "type": "string"
              },
              "task_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "task_id"
            ]
          },
          "example": {
            "kind": "aria2",
            "task_id": "2089b05ecca3d829"
          }
        }
      }
    }
  }
}
