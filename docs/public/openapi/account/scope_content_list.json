{
  "get": {
    "tags": [
      "账号"
    ],
    "summary": "获取账号主页指定分区内容",
    "description": "id 是归档账号主键字符串，scope 为平台主页分区，page 是平台分页游标字符串。仅支持实现 HomeDetailsFetcher 的平台，响应结构由平台适配器决定。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "$ref": "../components.json#/schemas/adapter_HomeDetails"
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "get_api_account_scope_content_list",
    "parameters": [
      {
        "name": "scope",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "平台账号主页分区值，取自响应 scopes[].value；不是内容列表的 all/task 范围"
      },
      {
        "name": "id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "归档账号主键字符串"
      },
      {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "页码，从 1 开始；账号主页接口使用平台分页游标"
      }
    ]
  }
}
