{
  "get": {
    "tags": [
      "账号"
    ],
    "summary": "查询已归档账号",
    "description": "page 默认 1，page_size 默认 24，最大 200。返回已归档账号及其 content_count、has_content。",
    "responses": {
      "200": {
        "description": "成功时 code=0；业务失败仍使用 HTTP 200，以 code 和 msg 判断结果。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "msg": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "list": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "platform_id": {
                            "type": "string"
                          },
                          "nickname": {
                            "type": "string"
                          },
                          "avatar_url": {
                            "type": "string"
                          },
                          "external_id": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "integer"
                          },
                          "updated_at": {
                            "type": "integer"
                          },
                          "content_count": {
                            "type": "integer"
                          },
                          "has_content": {
                            "type": "boolean"
                          },
                          "content_accounts": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "page_size": {
                      "type": "integer"
                    }
                  }
                }
              },
              "required": [
                "code",
                "msg"
              ]
            }
          }
        }
      }
    },
    "operationId": "get_api_account_list",
    "parameters": [
      {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        },
        "description": "页码，从 1 开始；账号主页接口使用平台分页游标"
      },
      {
        "name": "page_size",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 24,
          "minimum": 1,
          "maximum": 200
        },
        "description": "每页条数"
      },
      {
        "name": "keyword",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "搜索关键词"
      },
      {
        "name": "account_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "归档账号主键字符串"
      },
      {
        "name": "platform_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "平台标识，例如 wxchannels、wxmp、bilibili"
      }
    ]
  }
}
