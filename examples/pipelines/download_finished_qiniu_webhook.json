{
  "id": "download-finished-qiniu-webhook",
  "name": "下载完成后上传七牛云并通知 Webhook",
  "start_node": "start",
  "triggers": [
    {
      "id": "download-finished",
      "type": "Event",
      "name": "下载任务完成",
      "event_key": "downloadtask.finished",
      "active": true,
      "timeout_sec": 600
    }
  ],
  "context_schema": [
    {
      "key": "event",
      "type": "object",
      "required": true
    }
  ],
  "nodes": {
    "start": {
      "type": "StartNode",
      "name": "下载任务完成",
      "config": {},
      "next_node_ids": [
        "upload"
      ],
      "position": {
        "x": 0,
        "y": 0
      }
    },
    "upload": {
      "type": "QiniuUploadNode",
      "name": "上传到七牛云",
      "config": {
        "arguments": {
          "task": "{{input.event.data.task}}",
          "manifest_dir": "{{input.event.data.download_dir}}"
        },
        "output_key": "uploaded",
        "timeout_seconds": 600
      },
      "next_node_ids": [
        "webhook"
      ],
      "position": {
        "x": 300,
        "y": 0
      }
    },
    "webhook": {
      "type": "APICallNode",
      "name": "发送完成 Webhook",
      "config": {
        "url": "{{config.url}}",
        "method": "{{config.method}}",
        "body_type": "json",
        "headers": "{{config.headers}}",
        "timeout_seconds": 600,
        "fail_on_status": true,
        "output_key": "webhook_response",
        "authentication": {
          "type": "bearer",
          "token": "{{config.token}}"
        },
        "body_template": "{{config.body_template}}"
      },
      "next_node_ids": [
        "end"
      ],
      "position": {
        "x": 600,
        "y": 0
      },
      "config_schema": [
        {
          "key": "url",
          "label": "Webhook URL",
          "type": "string",
          "required": true,
          "default": "http://localhost:8080/webhook/download_task/success"
        },
        {
          "key": "method",
          "label": "HTTP Method",
          "type": "string",
          "required": true,
          "default": "POST",
          "options": [
            {
              "label": "GET",
              "value": "GET"
            },
            {
              "label": "POST",
              "value": "POST"
            },
            {
              "label": "PUT",
              "value": "PUT"
            },
            {
              "label": "PATCH",
              "value": "PATCH"
            },
            {
              "label": "DELETE",
              "value": "DELETE"
            },
            {
              "label": "HEAD",
              "value": "HEAD"
            },
            {
              "label": "OPTIONS",
              "value": "OPTIONS"
            }
          ]
        },
        {
          "key": "headers",
          "label": "Headers",
          "description": "JSON 对象，值可使用 {{input.event.data.task.id}} 等作用域模板。",
          "type": "object",
          "default": {
            "Content-Type": "application/json"
          }
        },
        {
          "key": "token",
          "label": "Bearer Token",
          "description": "可选，填写后覆盖 headers 中的 Authorization；留空时使用 headers 的认证配置。",
          "type": "string",
          "secret": true,
          "default": ""
        },
        {
          "key": "body_template",
          "label": "Body 模板",
          "description": "JSON 模板，先解析 JSON 再渲染作用域占位符；默认发送完整任务。GET/HEAD 不发送正文。",
          "type": "string",
          "required": true,
          "multiline": true,
          "default": "\"{{input.event.data.task}}\""
        }
      ]
    },
    "end": {
      "type": "EndNode",
      "name": "结束",
      "config": {},
      "next_node_ids": [],
      "position": {
        "x": 900,
        "y": 0
      }
    }
  }
}
